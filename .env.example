# -----------------------------------------------------------------------------
# THE GULAG — client (Vite) environment
# Copy this file to `.env` and fill in the values. Only VITE_* vars are exposed
# to the browser, so never put a private key here. The network itself
# (Solana mainnet-beta) is defined in src/network.js — no env var needed.
# -----------------------------------------------------------------------------

# $GULAG SPL token MINT address (base58). Optional — the client defaults to
# the live mint if unset, and also accepts the pre-rebrand VITE_FIGHT10_TOKEN
# and legacy VITE_FIGHT10_MINT names.
# Set this to point the client at a different mint (e.g. a test token).
VITE_GULAG_TOKEN=<GULAG_TOKEN_MINT>

# Escrow wallet PUBLIC address (base58) — deposits are sent here. Required.
VITE_ESCROW_WALLET=<ESCROW_WALLET_ADDRESS>

# SPL token decimals. Optional — the client reads the real value off the mint
# on-chain at boot, so this is only a seed/fallback. Pump.fun mints use 6.
VITE_GULAG_DECIMALS=6

# Override the cluster's public RPC (e.g. a dedicated Helius/QuickNode key).
# Optional — the public endpoint is heavily rate-limited, set a key for prod.
# VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# "Buy $GULAG" link (e.g. a Jupiter/Raydium swap URL). Optional — defaults to
# the token's Solscan explorer page.
# VITE_BUY_GULAG_URL=

# Supabase project. Required for auth / realtime / edge functions.
VITE_SUPABASE_URL=https://sajvismyvcgaszjcafcr.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
