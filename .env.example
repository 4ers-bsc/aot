# -----------------------------------------------------------------------------
# FIGHT10 — client (Vite) environment
# Copy this file to `.env` and fill in the values. Only VITE_* vars are exposed
# to the browser, so never put a private key here. The network itself
# (Robinhood Chain mainnet, chain id 4663) is defined in src/network.js — no env
# var needed.
# -----------------------------------------------------------------------------

# $FIGHT10 ERC-20 contract address (0x…40 hex). Required for live deposits and
# balances — an unset or malformed value leaves the client in its pre-launch
# state (no balance chip, no paid matches).
VITE_FIGHT10_TOKEN=<FIGHT10_TOKEN_ADDRESS>

# Escrow wallet PUBLIC address (0x…40 hex) — deposits are sent here. Required.
VITE_ESCROW_WALLET=<ESCROW_WALLET_ADDRESS>

# ERC-20 token decimals. Optional — the client reads the real value from the
# contract's decimals() at boot, so this is only a seed/fallback. Standard is 18.
VITE_FIGHT10_DECIMALS=18

# Override the network's public RPC (e.g. a dedicated Alchemy/QuickNode key).
# Optional — the public endpoint is rate-limited; set a dedicated key for prod.
# VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# "Buy $FIGHT10" link (e.g. a DEX swap URL on Robinhood Chain). Optional —
# defaults to the token's Blockscout explorer page.
# VITE_BUY_FIGHT10_URL=

# Supabase project. Required for auth / realtime / edge functions.
VITE_SUPABASE_URL=https://sajvismyvcgaszjcafcr.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
