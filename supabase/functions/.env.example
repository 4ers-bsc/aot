# -----------------------------------------------------------------------------
# FIGHT10 — Supabase edge function secrets (f10join / f10treasurer / f10admin)
#
# In production these are set as Supabase secrets:
#   supabase secrets set --env-file supabase/functions/.env
# For local `supabase functions serve`, copy this file to
# `supabase/functions/.env` and fill it in.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform automatically — you do NOT set them here.
# -----------------------------------------------------------------------------

# $FIGHT10 SPL token MINT address (base58) — used by all three functions. Required.
FIGHT10_TOKEN=<FIGHT10_TOKEN_MINT>

# Escrow PUBLIC address (base58, deposit destination) — used by f10join. Required.
ESCROW_WALLET=<ESCROW_WALLET_ADDRESS>

# Escrow signer secret key — used by f10treasurer & f10admin to sign payouts.
# Accepts a base58 secret key (Phantom "export private key") OR a JSON byte
# array (the `solana-keygen` id.json format, e.g. [12,34,...]). KEEP SECRET.
# The escrow account must also hold a little SOL for tx fees + the one-time rent
# when a winner's token account has to be created. Required for payouts.
ESCROW_PRIVATE_KEY=<ESCROW_PRIVATE_KEY>

# Optional RPC pool (round-robin + failover); falls back to the cluster's public
# RPC. Set a dedicated key (Helius/QuickNode/Triton) for production — the public
# endpoint is heavily rate-limited.
# RPC_URL=https://api.mainnet-beta.solana.com
# RPC_URL_2=
# RPC_URL_3=

# Dashboard display decimals for f10admin (on-chain paths read the mint's
# decimals live). The $FIGHT10 Pump.fun mint uses 6 — keep this in sync with the
# client's VITE_FIGHT10_DECIMALS so the Deployment tab shows a match.
FIGHT10_DECIMALS=6

# Locks CORS to the game origin — used by all three. Required.
APP_ORIGIN=http://localhost:3000

# Ops dashboard allowlist for f10admin (comma-separated). At least one needed
# to access the admin dashboard.
ADMIN_USER_IDS=
ADMIN_WALLETS=
